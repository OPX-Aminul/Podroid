#!/sbin/openrc-run

description="YourXDemon TCP agent (socat-based, StrykerApp-style)"

depend() {
    need net
    after opx-bootstrap
    before opx-ready
}

start() {
    ebegin "Starting YourXDemon TCP agent"
    # Kill any existing agent
    start-stop-daemon --stop --exec /usr/bin/socat 2>/dev/null
    sleep 0.5
    
    # Port 9050: non-interactive command execution (like StrykerApp port 1050)
    start-stop-daemon --start --exec /usr/bin/socat -- \
        TCP-LISTEN:9050,reuseaddr,fork EXEC:/bin/sh,stderr &
    
    # Port 9051: interactive PTY shell (like StrykerApp port 1051)
    if command -v bash >/dev/null 2>&1; then
        start-stop-daemon --start --exec /usr/bin/socat -- \
            TCP-LISTEN:9051,reuseaddr,fork EXEC:'bash -il',pty,setsid,ctty,stderr &
    else
        start-stop-daemon --start --exec /usr/bin/socat -- \
            TCP-LISTEN:9051,reuseaddr,fork EXEC:'/bin/sh -i',pty,setsid,ctty,stderr &
    fi
    
    eend $?
}

stop() {
    ebegin "Stopping YourXDemon TCP agent"
    start-stop-daemon --stop --exec /usr/bin/socat 2>/dev/null
    eend $?
}
