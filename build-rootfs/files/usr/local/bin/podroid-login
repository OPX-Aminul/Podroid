#!/bin/sh
# Replacement login shell for getty. Restores the terminal size from
# /run/term_size (written by podroid-resize on QEMU) before exec'ing the
# real login binary — virtio-console + PL011 serial both reset winsize
# to 0x0 on every getty respawn, so without this TUI apps (btop, htop,
# vim, less) bail with "Failed to get size of terminal".
#
# AVF doesn't run podroid-resize for ttyS0 (no SIGWINCH propagation
# channel yet), so /run/term_size won't exist there — fall back to a
# sensible default rather than leaving winsize at 0x0. The host-side
# TerminalView will overwrite this the moment the user touches the
# screen and triggers a real SIGWINCH.
_r=""
_c=""
if [ -r /run/term_size ]; then
    read _r _c < /run/term_size
fi
# Reject empty, non-numeric, and 0 (a 0x0 winsize is the exact failure this
# script exists to prevent: TUIs bail "Failed to get size of terminal").
case "$_r" in ''|*[!0-9]*|0) _r=24;; esac
case "$_c" in ''|*[!0-9]*|0) _c=80;; esac
stty rows "$_r" cols "$_c" 2>/dev/null
# Auto-login: skip password prompt for the primary use case.
#
# busybox getty's -l flag calls us as the login program, but it passes the
# username through stdin (first line typed), NOT as $1. So the old
# `if [ "$1" = "root" ]` check always fell through to /bin/login, which
# prompted for a password — defeating the auto-login the user expected.
#
# Fix: detect root by checking UID (works regardless of how we were invoked)
# and exec a login shell directly, bypassing /bin/login entirely.
if [ "$(id -u)" -eq 0 ] 2>/dev/null; then
    export USER=root
    export LOGNAME=root
    export HOME=/root
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    cd /root 2>/dev/null || cd /
    echo ""
    echo "  Welcome to YourXDemon v1.0.0"
    echo "  Developed by ExTV (Podroid) | Rebranded by OP Aminul FF (OPX)"
    echo ""
    # Source profile for a proper login environment.
    # Debian's /bin/sh is dash which doesn't support --login, so source
    # the profile manually then exec sh (no --login flag).
    [ -f /etc/profile ] && . /etc/profile
    [ -f /root/.profile ] && . /root/.profile
    exec /bin/sh
fi
exec /bin/login "$@"
