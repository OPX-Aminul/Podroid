# build-rootfs/Dockerfile.rootfs

# ── Stage 1: cross-compile vsock-agent + hostd (static aarch64) ─────────────
# Uses qemu-user under the hood — no separate cross-toolchain needed.
FROM --platform=linux/arm64 debian:trixie AS vsock-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc make libc6-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY vsock-agent /work/vsock-agent
RUN cd /work/vsock-agent && make CC=gcc
COPY host-bridge /work/host-bridge
RUN cd /work/host-bridge && make CC=gcc
COPY overlay-normalize /work/overlay-normalize
RUN cd /work/overlay-normalize && make CC=gcc

# ── Stage 2: build the Debian Trixie rootfs squashfs ────────────────────────
FROM debian:trixie AS builder

ARG DEBIAN_RELEASE=trixie
ARG DEBIAN_ARCH=arm64

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl squashfs-tools tar openssl libcap2-bin debootstrap \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Fetch the Debian Trixie minimal rootfs via debootstrap.
# We use a two-stage approach: first stage installs into a temporary dir,
# then we copy the result. Using --variant=minbase for a minimal install.RUN debootstrap --variant=minbase --arch=${DEBIAN_ARCH} \
    ${DEBIAN_RELEASE} /work/rootfs http://deb.debian.org/debian

# Pull in the vsock-agent binary built in stage 1.
COPY --from=vsock-builder /work/vsock-agent/podroid-vsock-agent /work/rootfs/usr/local/bin/podroid-vsock-agent
COPY --from=vsock-builder /work/host-bridge/podroid-hostd /work/rootfs/usr/local/bin/podroid-hostd
COPY --from=vsock-builder /work/host-bridge/yourxdemon-agentd /work/rootfs/usr/local/bin/yourxdemon-agentd
COPY --from=vsock-builder /work/overlay-normalize/podroid-overlay-normalize /work/rootfs/usr/local/bin/podroid-overlay-normalize

ARG SYSTEM_VERSION=0
ENV SYSTEM_VERSION=${SYSTEM_VERSION}

ENV DEBIAN_VERSION=${DEBIAN_RELEASE}
COPY files /work/files
COPY build-rootfs.sh /work/build-rootfs.sh
RUN chmod +x /work/build-rootfs.sh && /work/build-rootfs.sh

RUN mksquashfs /work/rootfs /work/yourxdemon-rootfs.squashfs \
    -comp zstd -Xcompression-level 19 -all-root -noappend

FROM scratch AS export
COPY --from=builder /work/yourxdemon-rootfs.squashfs /yourxdemon-rootfs.squashfs
